# Base URL of the backend API (FastAPI).
VITE_API_URL=http://localhost:8000

# Supabase project settings (Project Settings > API). The publishable/anon key is
# safe to ship to the browser; the browser signs in against Supabase and sends the
# resulting access token to the backend as a Bearer token.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
