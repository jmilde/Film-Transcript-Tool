# Postgres connection used by the API. Defaults to the local Dockerized dev
# Postgres (`make db-up`, port 5442 — see repo-root docker-compose.yml). Point
# both of these at a hosted Supabase project's pooler (6543)/direct (5432)
# ports instead if you want to develop against real hosted data.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5442/postgres

# Postgres connection used by the worker (needs a direct/session connection,
# not a transaction pooler, since migrations and the job-queue worker use
# session-scoped features). Defaults to the same local Dockerized dev Postgres.
DATABASE_URL_WORKER=postgresql+psycopg://postgres:postgres@localhost:5442/postgres

# Supabase project settings (Project Settings > API)
# Newer Supabase projects use publishable/secret keys + a JWKS endpoint for
# asymmetric JWT verification, rather than a legacy shared HS256 JWT secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Deepgram (transcription + diarization)
DEEPGRAM_API_KEY=your-deepgram-api-key

# OpenRouter (semantic chat search: agent, embeddings, and reranking all go
# through this one key)
OPENROUTER_API_KEY=your-openrouter-api-key

# Local filesystem storage root for media (original videos, proxies, waveforms, thumbnails)
STORAGE_ROOT=./storage

# Browser origins allowed to call the API (JSON array). Defaults to the Vite dev
# server; set this to the deployed frontend origin(s) in production.
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Secret for signing short-lived media-access tokens (the ?token= a <video>/<img>
# src uses, since it can't send an Authorization header). MUST be a strong random
# value in production; a dev default is used if unset.
MEDIA_TOKEN_SECRET=change-me-to-a-strong-random-secret
