# Supabase Postgres connection used by the API (transaction pooler, port 6543)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:6543/postgres

# Supabase Postgres connection used by the worker (direct/session connection, port 5432)
DATABASE_URL_WORKER=postgresql+psycopg://postgres:password@localhost:5432/postgres

# Supabase project settings (Project Settings > API)
# Newer Supabase projects use publishable/secret keys + a JWKS endpoint for
# asymmetric JWT verification, rather than a legacy shared HS256 JWT secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Deepgram (transcription + diarization)
DEEPGRAM_API_KEY=your-deepgram-api-key

# DeepL (translation)
DEEPL_API_KEY=your-deepl-api-key

# Local filesystem storage root for media (original videos, proxies, waveforms, thumbnails)
STORAGE_ROOT=./storage
